# App
DEBUG=false
APP_NAME=Nexora API

# PostgreSQL
DB_USER=nexora
DB_PASSWORD=change_me_in_production
DB_NAME=nexora
DATABASE_URL=postgresql://nexora:change_me_in_production@db:5432/nexora

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT — générer: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=/storage/uploads
RESULTS_DIR=/storage/results
TEMP_DIR=/storage/temp

# AutoDock Vina
VINA_PATH=/usr/local/bin/vina
VINA_CPU=4
VINA_EXHAUSTIVENESS=8

# NCBI
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=

# NVIDIA ESMFold API
# Obtenir votre clé API: https://build.nvidia.com/meta/esmfold
NVIDIA_API_KEY=your_nvidia_api_key_here

# Flower (Celery monitor) — user:password obligatoire
FLOWER_BASIC_AUTH=nexora:changeme
