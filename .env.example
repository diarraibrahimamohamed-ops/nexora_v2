# App
DEBUG=false
APP_NAME=Nexora API

# PostgreSQL
DB_USER=nexora
DB_PASSWORD=
DB_NAME=nexora
DATABASE_URL=postgresql://nexora:replace_with_unique_database_password@db:5432/nexora

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT — générer: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_DIR=/storage
UPLOAD_DIR=/storage/uploads
RESULTS_DIR=/storage/results
TEMP_DIR=/storage/temp

# AutoDock Vina
VINA_PATH=/usr/local/bin/vina
VINA_CPU=4
VINA_EXHAUSTIVENESS=8

# NCBI
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=

# NVIDIA ESMFold API — ancien endpoint, désactivé par défaut.
# ENABLE_DEPRECATED_NVIDIA_ESMFOLD=true uniquement pour un test historique explicite.
NVIDIA_API_KEY=your_nvidia_api_key_here
ENABLE_DEPRECATED_NVIDIA_ESMFOLD=false

# Tamarind Bio ESMFold API (alternative légère cloud)
# Obtenir votre clé API: https://app.tamarind.bio/api
TAMARIND_API_KEY=your_tamarind_api_key_here

# Flower (Celery monitor) — user:password obligatoire
FLOWER_BASIC_AUTH=

# First administrator: create and verify the account, then set its email here.
# This setting promotes an existing account; it does not create one.
ADMIN_EMAIL=

# African natural-product curation / offline library cache
ANPDB_BASE_URL=https://phabidb.vm.uni-freiburg.de
AFRICAN_LIBS_DIR=/storage/african_libs
PUBCHEM_API_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
PHYTOCHEM_MAX_IMPORT=500

# AMRFinderPlus binary is installed in the API/worker image by default.
# Initialize the separate reference DB: docker compose --profile amrfinder-db-init run --rm amrfinder-db-init
AMRFINDER_PATH=/usr/local/bin/amrfinder
AMRFINDER_UPDATE_PATH=/usr/local/bin/amrfinder_update
AMRFINDER_DB_DIR=/storage/reference/amrfinder
AMRFINDER_REQUIRED=false


# Optional AMRFinderPlus runtime (image rebuild + separate reference DB update)
INSTALL_AMRFINDERPLUS=true
AMRFINDERPLUS_VERSION=4.2.7

# Optional local assistant; in Docker use host.docker.internal (native run: http://127.0.0.1:11434); deterministic bioinformatics does not depend on Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma2:2b
OFFLINE_PACKAGES_DIR=/storage/offline_packages
